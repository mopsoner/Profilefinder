GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Ads uses the same OPENAI_API_KEY as the rest of ProfileFinder.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional alternative voice provider.
ELEVENLABS_API_KEY=
DATABASE_URL=sqlite:///./data/profilefinder.db
APP_HOST=0.0.0.0
APP_PORT=8000

# Set this to <= your Nearby Search (New) project quota.
GOOGLE_PLACES_NEARBY_RPM=60
GOOGLE_PLACES_WORKERS=8

# Maximum original images per cinematic video project (1 to 8).
VIDEO_AI_MAX_IMAGES=4
